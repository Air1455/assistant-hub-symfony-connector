{
  "name": "assistant-hub/symfony-connector",
  "description": "Connecteur Symfony réutilisable pour Assistant Hub",
  "type": "symfony-bundle",
  "keywords": [
    "assistant",
    "connector",
    "symfony"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "POWEG",
      "homepage": "https://poweg.fr"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "psr/cache": "^3.0",
    "symfony/cache": "^6.4 || ^7.0",
    "symfony/config": "^6.4 || ^7.0",
    "symfony/dependency-injection": "^6.4 || ^7.0",
    "symfony/framework-bundle": "^6.4 || ^7.0",
    "symfony/http-client": "^6.4 || ^7.0",
    "symfony/http-foundation": "^6.4 || ^7.0",
    "symfony/routing": "^6.4 || ^7.0",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "AssistantHub\\SymfonyConnector\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AssistantHub\\SymfonyConnector\\Tests\\": "tests/"
    }
  },
  "archive": {
    "name": "assistant-hub-symfony-connector"
  },
  "extra": {
    "symfony": {
      "endpoint": [
        "https://api.github.com/repos/symfony/recipes-contrib/contents/index.json",
        "flex://defaults"
      ]
    }
  }
}
